# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
# If provided, customer court requests and admin updates sync directly with Supabase.
SUPABASE_URL=""

# SUPABASE_ANON_KEY: Supabase public anon key or service_role key
SUPABASE_ANON_KEY=""
