# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE_URL: URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
# If provided, customer court requests and admin updates sync directly with Supabase.
SUPABASE_URL=""

# Server-only key. Required on Vercel; never prefix this with VITE_.
SUPABASE_SERVICE_ROLE_KEY=""

# Required for deployed admin login. Local development has demo defaults.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
